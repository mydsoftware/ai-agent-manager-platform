# Database (PostgreSQL)
DATABASE_URL=

# Auth — required in production, min 32 chars. Dev falls back to an insecure secret.
JWT_SECRET=

# Comma-separated admin emails promoted at registration
ADMIN_EMAILS=

# CORS — comma-separated origins or * for dev
CORS_ORIGINS=*

# LLM providers (first configured wins unless LLM_PROVIDER set)
LLM_PROVIDER=openai|openrouter|custom
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Tools
SEARCH_API_URL=
SEARCH_API_KEY=

# Payments — stub is test-only and hard-disabled in production.
# Set PAYMENT_PROVIDER to a real gateway adapter once available.
PAYMENT_PROVIDER=stub
PAYMENT_STUB_AUTO_SUCCESS=true

# Optional topup bounds/conversion overrides
MIN_TOPUP_IRR=10000
MAX_TOPUP_IRR=500000000
IRR_PER_CREDIT=1000
