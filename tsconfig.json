{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["api/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
