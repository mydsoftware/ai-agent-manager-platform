{
  "name": "ai-agent-manager",
  "version": "0.2.0",
  "private": true,
  "description": "AI Agent Manager — Open-Core Platform",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "start": "tsx api/server.ts",
    "dev": "tsx watch api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "prisma generate --schema prisma/schema.prisma && tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.5",
    "jose": "^5.9.6",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
